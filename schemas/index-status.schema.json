{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KSAModding/content-index/main/schemas/index-status.schema.json",
  "title": "index-status.toml",
  "description": "The index's own voice about a listing, per RFC 0033. Whether an id resolves needs the whole index and is tools/check_status.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "state": {
          "enum": ["delisted", "disputed", "retracted"]
        },
        "version": { "$ref": "#/$defs/semver" },
        "since": { "$ref": "#/$defs/utcTimestamp" },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "$comment": "retracted scopes to one pack version. delisted and disputed cover the whole entry.",
          "if": {
            "required": ["state"],
            "properties": { "state": { "const": "retracted" } }
          },
          "then": { "required": ["version"] },
          "else": {
            "properties": {
              "version": {
                "not": {},
                "title": "only allowed on a retracted state, which scopes to one pack version"
              }
            }
          }
        }
      ]
    },
    "contentId": {
      "$comment": "The same rule as an authored document's id.",
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?(?![\\s\\S])",
      "not": {
        "title": "a reserved name, compared up to the first dot",
        "pattern": "^(?:[Cc][Oo][Rr][Ee]|[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|(?![\\s\\S]))"
      }
    },
    "semver": {
      "$comment": "A pack version. No leading v.",
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?(?![\\s\\S])"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z(?![\\s\\S])"
    }
  }
}
